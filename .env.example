# TMDB v3 API key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# Optional und bevorzugt: v4 Read Access Token statt API-Key in der URL
TMDB_BEARER_TOKEN=

# SQLite for the local MVP. Replace with PostgreSQL when the schema provider is migrated.
DATABASE_URL="file:./dev.db"

# Use the bundled catalogue when no TMDB key is configured.
DEMO_MODE=true
