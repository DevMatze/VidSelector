# Bevorzugtes TMDB-v4-Lesezugriffstoken.
TMDB_BEARER_TOKEN=

# Alternativer klassischer TMDB-v3-API-Schlüssel.
TMDB_API_KEY=

# Verbindungsadresse der lokalen SQLite-Datenbank.
DATABASE_URL="file:./dev.db"

# Docker: standardmäßig nur auf diesem Computer erreichbar; 0.0.0.0 erlaubt den Zugriff im vertrauenswürdigen LAN.
VIDSELECTOR_BIND_ADDRESS=127.0.0.1

# Docker: veröffentlichter Port auf dem Host.
VIDSELECTOR_PORT=3000

# Docker: zu verwendende YAML-Konfiguration. Für eigene Einstellungen zuerst config.example nach config.yml kopieren.
VIDSELECTOR_CONFIG_FILE=./config.example
